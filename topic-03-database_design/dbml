Table books {
  id               int          [pk, increment]
  title            varchar(255) [not null]
  isbn             varchar(17)  [unique, not null]
  publication_year smallint

  constraints {
    `publication_year BETWEEN 1000 AND 2100` [name: 'chk_pub_year']
  }
}

Table book_genres {
  book_id  int [not null, ref: > books.id]
  genre_id int [not null, ref: > genres.id]

  indexes {
    (book_id, Genre_id) [pk]
  }
}

Table genres {
  id   int          [pk, increment]
  name varchar(255) [not null]
}

Table authors {
  id         int         [pk, increment]
  first_name varchar(50) [not null]
  last_name  varchar(50) [not null]
}


Table book_authors {
  book_id   int [ref: > books.id]
  author_id int [ref: > authors.id]


  indexes {
    (book_id, author_id) [pk]
  }
}


Table categories {
  id   int         [pk, increment]
  name varchar(40) [not null, unique]
}


Table book_categories {
  book_id     int [ref: > books.id]
  category_id int [ref: > categories.id]


  indexes {
    (book_id, category_id) [pk]
  }
}

Table members {
  id            int          [pk, increment]
  first_name    varchar(50)  [not null]
  last_name     varchar(50)  [not null]
  email         varchar(100) [not null, unique]
  login         varchar(100) [not null, unique]
  password_hash varchar(128) [not null]
  phone         varchar(20)  [not null]
  address       varchar(150) [not null]
}


Table copy_statuses {
  id   int         [pk, increment]
  name varchar(15) [not null, unique]
}


Table book_copies {
  id             int         [pk, increment]
  book_id        int         [ref: > books.id, not null]
  barcode        varchar(30) [not null, unique]
  copy_status_id int         [ref: > copy_statuses.id, not null]
}


Table borrowing_statuses {
  id   int         [pk, increment]
  name varchar(15) [not null, unique]
}


Table borrowings {
  id             int       [pk, increment]
  member_id      int       [not null, ref: > members.id]
  borrowing_date timestamp [not null, default: `now()`]
  due_date       timestamp [not null]
  return_date    timestamp
  status_id      int       [not null, ref: > borrowing_statuses.id]

  constraints  {
    `due_date > borrowing_date`                                [name: 'chk_due_after_borrow']
    `return_date IS NULL OR return_date >= borrowing_date`     [name: 'chk_return_after_borrow']
  }
}

Table borrowing_items {
  id             int [pk, increment]
  borrowing_id   int [not null, ref: > borrowings.id]
  book_copy_id   int [not null, ref: > book_copies.id]

  indexes {
    (borrowing_id, book_copy_id) [unique, name: 'uq_borrowing_copy']
  }
}

Table reservation_statuses {
  id   int         [pk, increment]
  name varchar(15) [not null, unique]
}


Table reservations {
  id               int       [pk, increment]
  member_id        int       [ref: > members.id, not null]
  reservation_date timestamp [not null, default: `now()`]
  status_id        int       [ref: > reservation_statuses.id, not null]
}

Table reservation_items {
  id                  int [pk, increment]
  reservation_id      int [not null, ref: > reservations.id]
  book_id             int [not null, ref: > books.id]
  book_copy_id        int [null, ref: > book_copies.id]
  reservation_amount  int [not null, default: 1]

  indexes {
    (reservation_id, book_id) [name: 'idx_res_items_res_book']
  }
}


Table book_reviews {
  id          int       [pk, increment]
  member_id   int       [ref: > members.id, not null]
  book_id     int       [ref: > books.id, not null]
  review_text text
  created_at  timestamp [not null, default: `now()`]
  rate        smallint  [not null]


  indexes {
    (member_id, book_id) [unique, name: 'uq_one_review_per_book']
  }


  constraints  {
    `rate BETWEEN 1 AND 5` [name: 'chk_rate']
  }
}
